# Copy to .env and fill in. Nothing here is required to run the project:
# every value below has a working default.

# ---------------------------------------------------------------------------
# Price provider
# ---------------------------------------------------------------------------
# "fixture" (default) serves prices from a checked-in JSON file, so the whole
# pipeline runs offline and deterministically. "serpapi" calls the real
# Google Flights engine and needs SERPAPI_KEY.
FLIGHT_PRICE_PROVIDER=fixture
SERPAPI_KEY=

# How long a fetched quote stays reusable before the provider is called again.
PRICE_QUOTE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Fare review (optional AI step)
# ---------------------------------------------------------------------------
# "heuristic" (default) scores the fare with a cents-per-mile band table.
# "claude" asks the Anthropic Messages API and falls back to the heuristic
# when no credentials are present.
FARE_REVIEWER=heuristic
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-before-deploying
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
# Leave unset to run tasks inline (CELERY_TASK_ALWAYS_EAGER) with no broker.
CELERY_BROKER_URL=
